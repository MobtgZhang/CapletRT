# Renode boot script for hello-allwinner-a20-qemu. The board writes to
# the emulated sun7i UART0, so capture that peripheral rather than the
# semihosting channel.
mach create "allwinner-a20"
machine LoadPlatformDescription @REPL@
sysbus LoadELF @ELF@
uart0 CreateFileBackend @OUT@
start
sleep 2
quit
