// Offline STM32F405 subset used by the optional STM32F4 Renode boot.
//
// The stock platforms/cpus/stm32f4.repl downloads an SVD from
// dl.antmicro.com during platform load.  CapletRT only needs the core,
// memories, NVIC, RCC/GPIO and semihosting channel, so model that
// subset locally and keep simulation deterministic and offline.

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x00100000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00030000

sramAlias: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x00030000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 16000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

rtc: Timers.STM32F4_RTC @ sysbus 0x40002800

rcc: Miscellaneous.STM32F4_RCC @ sysbus 0x40023800
    rtcPeripheral: rtc

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x40020400, +0x400>
    numberOfAFs: 16

semihosting: CPU.SemihostingHandler @ cpu
uart: UART.SemihostingUart @ semihosting
