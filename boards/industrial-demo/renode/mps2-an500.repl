// Renode model of the MPS2-AN500 board used by industrial-demo.
// The flash/RAM windows match boards/industrial-demo/memory.x.

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 25000000
    IRQ -> cpu@0

flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x00400000

ram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00400000

semihosting: CPU.SemihostingHandler @ cpu
uart: UART.SemihostingUart @ semihosting
